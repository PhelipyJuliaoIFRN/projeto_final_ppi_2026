<!-- Seção do formulário de cadastro de livros -->
<section class="form-container">
  <div class="form-card">
    <!-- Cabeçalho explicativo do formulário -->
    <header class="form-header">
      <h1>Cadastrar <span class="highlight">Livro</span></h1>
      <p>Preencha os campos abaixo para adicionar um novo livro à coleção.</p>
    </header>

    <!-- Formulário para envio dos dados do livro via POST -->
    <form action="/books/add/create" method="POST" class="book-form">
      <!-- Campo para o Título do Livro -->
      <div class="form-control">
        <label for="title">Título</label>
        <input 
          type="text" 
          id="title" 
          name="title" 
          placeholder="Ex: O Senhor dos Anéis" 
          required
        >
      </div>

      <!-- Campo para a Quantidade de Páginas -->
      <div class="form-control">
        <label for="pageqty">Número de páginas</label>
        <input 
          type="number" 
          id="pageqty" 
          name="pageqty" 
          placeholder="Ex: 350" 
          min="1" 
          required
        >
      </div>

      <!-- Botão para submeter o formulário -->
      <button type="submit" class="btn-submit">Cadastrar Livro</button>
    </form>
  </div>
</section>